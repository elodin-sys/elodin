// Falcon 9 launch-to-landing cinematic ECEF scene.

coordinate frame="ECEF"
// Keep live graph redraw bounded at 1000 Hz.
timeline follow_latest=#true range="last_30s"
telemetry_mode #true

// The CRS-12 playhead drives the built-in Earth's ephemeris sun.
environment {
    sun illuminance=100000.0 shadows=#true
    ambient scale=0.05
    earth
}

// Cinematic chase viewport with telemetry panels.
vsplit {
    hsplit share=0.75 {
        viewport name="Chase" share=0.72 near=1.0 far=120000000.0 pos="booster.world_pos.translate_world(46.740, -100.549, -144.705)" look_at="booster.world_pos.translate_world(1.433, -8.661, 4.788)" up="(0.1433, -0.8661, 0.4788)" cinematic=#true show_grid=#false active=#true
        vsplit share=0.28 {
            hsplit {
                graph "booster.ground_speed[0], booster_truth.ground_speed[0]" name="Speed vs recorded (m/s)" {
                    color blue
                    color green
                }
                graph "booster.mach[0]" name="Mach" {
                    color white
                }
            }
            hsplit {
                graph "booster.altitude_geodetic[0], booster_truth.altitude_geodetic[0]" name="Altitude vs recorded (m)" {
                    color blue
                    color green
                }
                graph "booster.tank_pressure_lox[0], booster.tank_pressure_rp1[0], booster.inlet_pressure_lox[0], booster.inlet_pressure_rp1[0]" name="Tank + inlet pressures (Pa)" {
                    color cyan
                    color orange
                    color blue
                    color red
                }
            }
            hsplit {
                graph "booster.propellant_lox[0], booster.propellant_rp1[0]" name="Propellant (kg)" {
                    color cyan
                    color orange
                }
                graph "booster.nitrogen_kg[0]" name="RCS nitrogen (kg)" {
                    color white
                }
            }
        }
    }
    hsplit share=0.25 {
        graph "booster.fsw_phase[0]" name="Mission phase (0..11)" {
            color yellow
        }
        graph "booster.thrust_total[0]" name="Cluster thrust (N)" {
            color orange
        }
        graph "booster.qbar[0]" name="Dynamic pressure (Pa)" {
            color red
        }
        graph "booster.fin_state" name="Grid fins (rad)" {
        }
        graph "booster.rcs_levels" name="RCS thrusters (8)" {
        }
        graph "booster.engine_spool" name="Engine spool (%)" {
        }
        graph "booster.tvc_state" name="TVC gimbal (rad)" {
        }
    }
}

// Rotate the 70 m Y-up GLB onto the simulation's body +X axis.
object_3d orientation=absolute booster.world_pos {
    glb path="falcon9.glb" rotate="(0, 0, -90)" scale=0.9944
    icon builtin="rocket_launch" size=32 {
        color 70 130 240
    }
    // Spawn the Merlin plume at the bell-exit plane.
    thruster name="merlin" effect="effects/falcon9/merlin_core.effect" body_frame=#true position="(-1.2, 0, 0)" intensity="booster.plume_viz" {
        effect "effects/falcon9/merlin_flame.effect"
        light color="(1.0, 0.83, 0.58)" intensity=30000000.0 range=120.0 offset=6.0
    }
    // Keep the exhaust trail world-anchored while thinning it with air density.
    thruster name="exhaust_smoke" effect="effects/falcon9/exhaust_smoke.effect" body_frame=#true position="(-8, 0, 0)" direction="(-1, 0, 0)" intensity="booster.smoke_viz[0]" cutoff=0.01
    // Cold-gas RCS: falcon9-sized darts (rcs_dart) at interstage station 46 m.
    thruster name="rcs_0" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, 1.83, 0.0)" direction="(0, 0, -1)" intensity="booster.rcs_levels[0]" cutoff=0.003
    thruster name="rcs_1" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, 1.83, 0.0)" direction="(0, 0, 1)" intensity="booster.rcs_levels[1]" cutoff=0.003
    thruster name="rcs_2" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, -1.83, 0.0)" direction="(0, 0, -1)" intensity="booster.rcs_levels[2]" cutoff=0.003
    thruster name="rcs_3" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, -1.83, 0.0)" direction="(0, 0, 1)" intensity="booster.rcs_levels[3]" cutoff=0.003
    thruster name="rcs_4" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, 1.83, 0.0)" direction="(0, -1, 0)" intensity="booster.rcs_levels[4]" cutoff=0.003
    thruster name="rcs_5" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, 1.83, 0.0)" direction="(0, 1, 0)" intensity="booster.rcs_levels[5]" cutoff=0.003
    thruster name="rcs_6" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, -1.83, 0.0)" direction="(0, 1, 0)" intensity="booster.rcs_levels[6]" cutoff=0.003
    thruster name="rcs_7" effect="effects/falcon9/rcs_dart.effect" body_frame=#true position="(46.0, -1.83, 0.0)" direction="(0, -1, 0)" intensity="booster.rcs_levels[7]" cutoff=0.003
}

// World-fixed launch-pad smoke.
object_3d orientation=absolute pad.world_pos {
    sphere radius=0.02
    thruster name="pad_smoke" effect="effects/falcon9/pad_smoke.effect" body_frame=#true position="(0, 2, 0)" direction="(0, -1, 0)" intensity="booster.pad_smoke_viz[0]" cutoff=0.01
}

// Landing dust and ASDS visual at LZ-1.
object_3d orientation=absolute lz1.world_pos {
    // Y-up, deck-centered ASDS mesh.
    glb path="spacex_drone_barge.glb"
    thruster name="lz1_smoke" effect="effects/falcon9/pad_smoke.effect" body_frame=#true position="(0, 2, 0)" direction="(0, -1, 0)" intensity="booster.landing_smoke_viz[0]" cutoff=0.01
}

// CRS-12 truth ghost.
object_3d booster_truth.world_pos {
    sphere radius=0.5 {
        color 60 200 90 160
    }
    icon builtin="my_location" size=24 {
        color 60 200 90
    }
}

line_3d booster.world_pos line_width=2.0 perspective=#false {
    color 70 130 240 200
}
line_3d booster_truth.world_pos line_width=2.0 perspective=#false {
    color 60 200 90 160
}
