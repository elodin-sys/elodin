// BDX RC jet cinematic ECEF scene over Death Valley.
//
// Site (baked): valley floor 36.2300 N, 116.9700 W, field elevation -60 m.
// Chase / TGT / top-down ECEF offsets assume the default heading 350°
// (up-valley). Terrain ENU translate is the death_valley region center
// relative to that site, with vertical = region_min_height - field_elevation
// (-86 - -60 = -26 m). Pinned SW 40° sun for a deterministic golden-hour
// scene; drop `direction` to track the playhead ephemeris.

coordinate frame="ECEF" lat=36.23 lon=-116.97 alt=-60.0

timeline follow_latest=#true range="last_30s"
telemetry_mode #true

// Cinematic Earth: horizon, atmosphere, star field. Close-up terrain is
// the geo-anchored death_valley world_mesh below.
environment {
    sun illuminance=100000.0 shadows=#true direction="(-0.863, -0.502, -0.057)"
    ambient scale=0.05
    earth
}

world_mesh "death_valley" frame="ENU" translate="(-10338.528, 6.132, -26.000)"

tabs {
    hsplit name="Main View" {
        vsplit share=0.4 {
            // ECEF pose: the gauge derives the local vertical from the
            // vehicle's own position (ellipsoid normal).
            horizon_gauge "bdx.world_pos" name="ADI" share=3.0
            graph "bdx.alpha" name="Angle of Attack (rad)"
            graph "bdx.aero_valid" name="Aero Validity Flag"
        }
        viewport name=Chase cinematic=#true near=1.0 pos="bdx.world_pos.translate_world(-3.028, -12.076, -10.642)" look_at="bdx.world_pos.translate_world(-0.076, 2.147, 5.948)" up="(-0.366, -0.719, 0.591)" show_grid=#false active=#true
        vsplit share=0.4 {
            viewport name=TGTViewport pos="target.world_pos.translate_world(1.086, -0.071, 0.925)" look_at="bdx.world_pos" show_grid=#false
            viewport name=FPVViewport pos="bdx.world_pos.translate(1,0,0.1)" look_at="bdx.world_pos.translate(2,0,0.1)" up="bdx.world_pos.direction(0,0,1)" show_grid=#false
            sensor_view "bdx.fpv_cam" name="FPV (sensor_camera)"
        }
    }
    vsplit name="Flight Data" {
        hsplit {
            graph "bdx.velocity_body" name="Body Velocity (m/s)"
            graph "bdx.geodetic.alt_m" name="Geodetic Altitude (m)"
        }
        hsplit {
            graph "bdx.control_surfaces" name="Control Surfaces (rad)"
            graph "bdx.dynamic_pressure, bdx.mach" name="Dynamic Pressure / Mach"
        }
    }
    vsplit name="Propulsion" {
        hsplit {
            graph "bdx.thrust" name="Thrust (N)"
            graph "bdx.spool_speed" name="Effective Throttle (spool)"
        }
        hsplit {
            graph "bdx.fuel_mass" name="Fuel Mass (kg)"
            graph "bdx.fuel_flow" name="Fuel Flow (kg/s)"
        }
    }
    vsplit name="Control Input" {
        graph "bdx.control_commands" name="Control Commands (rad/normalized)"
        graph "bdx.control_surfaces" name="Control Surfaces (rad)"
    }
    vsplit name="Aerodynamics" {
        hsplit {
            graph "bdx.alpha" name="Angle of Attack (rad)"
            graph "bdx.beta" name="Sideslip (rad)"
        }
        hsplit {
            graph "bdx.aero_coefs.CL, bdx.aero_coefs.CD" name="CL, CD"
            graph "bdx.aero_coefs.Cm" name="Pitch Moment Cm"
        }
    }
    hsplit name="Navigation" {
        viewport name="Top-Down View" pos="bdx.world_pos.translate_world(-54.875, -107.838, 88.654)" look_at="bdx.world_pos" up="(0.268, 0.527, 0.807)" fov=60.0 show_grid=#false
        query_plot name="Ground Track (ENU)" query="SELECT bdx_pos_enu.bdx_pos_enu[1], bdx_pos_enu.bdx_pos_enu[2] FROM bdx_pos_enu" type="sql" mode="xy" x_label="East (m)" y_label="North (m)" auto_refresh=#true refresh_interval=500 {
            color cyan
        }
    }
}

// Package render mesh: already Elodin body (X forward, Y left, Z up, CG
// origin). The editor always lifts glTF Y-up with Rx(+90°); this Rx(-90°)
// cancels that so a Z-up GLB is not rolled onto its side. Do not rewrite
// the hashed package GLB — assets/bdx.glb is hash-checked by the tests.
object_3d bdx.world_pos {
    glb path="bdx.glb" rotate="(-90, 0, 0)"
    icon builtin="flight_takeoff" {
        visibility_range min=50.0 fade_distance=50.0
        color 76 175 80
    }
}

object_3d target.world_pos {
    glb path="edu-450-v2-drone.glb"
    icon builtin="adjust" {
        visibility_range min=50.0 fade_distance=50.0
        color 244 67 54
    }
}

vector_arrow "(1, 0, 0)" origin="bdx.world_pos" scale=1.0 name="Forward (X)" show_name=#true body_frame=#true {
   color red 150
}
vector_arrow "(0, 1, 0)" origin="bdx.world_pos" scale=1.0 name="Left (Y)" show_name=#true body_frame=#true {
   color green 150
}
vector_arrow "(0, 0, 1)" origin="bdx.world_pos" scale=1.0 name="Up (Z)" show_name=#true body_frame=#true {
   color blue 150
}

line_3d bdx.world_pos line_width=3.0 perspective=#false {
    color yolk
}
