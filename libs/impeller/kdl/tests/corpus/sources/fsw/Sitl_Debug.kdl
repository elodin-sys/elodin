                viewport name="Target_RadarKF_View" pos="(0,0,0,0, 1,-10,4) + (0,0,0,1,rocket.radar_target_state_kalman[0],rocket.radar_target_state_kalman[1],rocket.radar_target_state_kalman[2])" look_at="(0,0,0,1,rocket.radar_target_state_kalman[0],rocket.radar_target_state_kalman[1],rocket.radar_target_state_kalman[2])" show_grid=#true
