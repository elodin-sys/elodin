object_3d "(0,0,0,1, MFNAVELODINENUMESSAGE.WORLD_POS[4],MFNAVELODINENUMESSAGE.WORLD_POS[5],MFNAVELODINENUMESSAGE.WORLD_POS[6])" {
    glb path="models/compass.glb"
}
object_3d rocket.world_pos {
    glb path="models/missile_FT10_20251205_2.glb"
}
object_3d MFNAVELODINENUMESSAGE.WORLD_POS {
    glb path="models/articulated-missile.glb"
    animate joint=Root.Fin_0 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[0], 0)"
    animate joint=Root.Fin_1 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[1], 0)"
    animate joint=Root.Fin_2 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[2], 0)"
    animate joint=Root.Fin_3 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[3], 0)"
}
object_3d "(0,0,0,1, MFNAVELODINENUMESSAGE.WORLD_POS[4],MFNAVELODINENUMESSAGE.WORLD_POS[5],MFNAVELODINENUMESSAGE.WORLD_POS[6])" {
    ellipsoid error_covariance_cholesky="(NAVCHOLCOVMESSAGE.CHOLPOS[0], NAVCHOLCOVMESSAGE.CHOLPOS[1], NAVCHOLCOVMESSAGE.CHOLPOS[2], NAVCHOLCOVMESSAGE.CHOLPOS[3], NAVCHOLCOVMESSAGE.CHOLPOS[4], NAVCHOLCOVMESSAGE.CHOLPOS[5])" show_grid=#true error_confidence_interval="70" {
        color 255 200 100 100
        grid_color 255 255 255 255
    }
}
object_3d target.world_pos {
    glb path="models/shahed.glb"
}
object_3d "(0,0,0,1,rocket.radar_target_state_kalman[0],rocket.radar_target_state_kalman[1],rocket.radar_target_state_kalman[2])" {
    glb path="models/shahed.glb"
}
object_3d "(rocket.world_pos[0],rocket.world_pos[1],rocket.world_pos[2],rocket.world_pos[3],rocket.radar_missile_state_kalman[0],rocket.radar_missile_state_kalman[1],rocket.radar_missile_state_kalman[2])" {
    glb path="models/missile_FT10_20251205_2.glb"
}
line_3d rocket.world_pos perspective=#false {
    color green
}
line_3d MFNAVELODINENUMESSAGE.WORLD_POS perspective=#false {
    color blue
}
// Optional target/radar traces:
line_3d target.world_pos perspective=#false {
    color red
}
line_3d "(0,0,0,1,rocket.radar_target_state_kalman[0],rocket.radar_target_state_kalman[1],rocket.radar_target_state_kalman[2])" perspective=#false {
    color 214 164 54
}
line_3d "(0,0,0,1,rocket.radar_missile_state_kalman[0],rocket.radar_missile_state_kalman[1],rocket.radar_missile_state_kalman[2])" perspective=#false {
    color 255 165 0
}
vector_arrow "(rocket.world_vel[3], rocket.world_vel[4], rocket.world_vel[5])" origin=rocket.world_pos scale=0.1 name="Truth Velocity (ENU)" {
    color 180 80 255
}
vector_arrow "(MFNAVELODINENUMESSAGE.VEL_ENU[0], MFNAVELODINENUMESSAGE.VEL_ENU[1], MFNAVELODINENUMESSAGE.VEL_ENU[2])" origin=MFNAVELODINENUMESSAGE.WORLD_POS scale=0.1 name="Nav Velocity (ENU)" {
    color 180 80 255
}
vector_arrow "(1, 0, 0)" origin="(rocket.world_pos[0],rocket.world_pos[1],rocket.world_pos[2],rocket.world_pos[3],rocket.radar_missile_state_kalman[0],rocket.radar_missile_state_kalman[1],rocket.radar_missile_state_kalman[2])" scale=2.0 name="Missile Radar KF" body_frame=#true {
    color 255 165 0
}
// vector_arrow "(0, GUIDANCEMESSAGE.ACC_CMD_NED[0], GUIDANCEMESSAGE.ACC_CMD_NED[1])" origin=MFNAVELODINENUMESSAGE.WORLD_POS name="Guidance Cmd Accel (NED)" body_frame=#false {
//     color 255 165 0
// }
vector_arrow "(0, CONTROLMESSAGE.ACC_CMD_BODY[0], CONTROLMESSAGE.ACC_CMD_BODY[1])" origin=MFNAVELODINENUMESSAGE.WORLD_POS name="Rocket Commanded Acceleration" body_frame=#true {
    color cyan
}
vector_arrow "(0, CONTROLMESSAGE.ACC_MEAS_BODY[0], CONTROLMESSAGE.ACC_MEAS_BODY[1])" origin=MFNAVELODINENUMESSAGE.WORLD_POS name="Rocket Measured Acceleration" body_frame=#true {
    color 255 0 255
}
vector_arrow "(target.world_pos[4], target.world_pos[5], target.world_pos[6]) - (rocket.world_pos[4],rocket.world_pos[5],rocket.world_pos[6])" origin=rocket.world_pos scale=0.0 name="Target SIM LOS" {
    color 100 100 100
}
vector_arrow "(rocket.sitl_los_enu[0], rocket.sitl_los_enu[1], rocket.sitl_los_enu[2])" origin=rocket.world_pos name="Target Controls LOS" {
    color white
}
vector_arrow "(0,0,1)" origin=target.world_pos scale=50.0 name="Target Visibility" {
    color red
}
