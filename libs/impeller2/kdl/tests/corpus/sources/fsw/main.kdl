    hsplit name=Dynamics {
        vsplit name="World Info" share=1.661305 {
            viewport name=Missile frame=ECEF near=0.1 pos="(0,0,0,0,-1.288,-3.513,-3.500) + (NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false share=1.5 show_frustum=#true show_view_cube=#false
            viewport name=Target frame=ECEF near=0.1 pos="(0,0,0,0,-3.337,-8.470,-5.842) + (0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" look_at="(0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false share=0.639168 show_frustum=#true show_view_cube=#false
            // 2x2 vehicle kinematics (same treatment as Dynamics and Fin Cams).
            hsplit name="Vehicle Kinematics" share=1.810617 {
                vsplit {
                    graph "NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]" name="Vehicle Pos ECEF" {
                        color 76 175 80
                        color 33 150 243
                        color 255 193 7
                    }
                    graph "NAVEKFCOV.PPOS_ECEF[0].sqrt(),NAVEKFCOV.PPOS_ECEF[2].sqrt(),NAVEKFCOV.PPOS_ECEF[5].sqrt()" name="Vehicle Pos STD ECEF" {
                        color 244 67 54
                        color 255 152 0
                        color 156 39 176
                    }
                }
                vsplit {
                    graph "NAVEKFSTATE.VEL_ECEF[0],NAVEKFSTATE.VEL_ECEF[1],NAVEKFSTATE.VEL_ECEF[2]" name="Vehicle Vel ECEF" {
                        color 76 175 80
                        color 33 150 243
                        color 255 193 7
                    }
                    graph "CONTROLMESSAGE.P_DPS,CONTROLMESSAGE.Q_DPS,CONTROLMESSAGE.R_DPS" name="Body Rates (deg/s)" {
                        color 108 60 40
                        color 132 93 40
                        color 82 31 20
                    }
                }
            }
            hsplit share=0.550215 {
                graph "TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2]" name="Target Pos ECEF" {
                    color 212 10 10
                    color 255 87 34
                    color 255 152 0
                }
                graph "TARGETMESSAGE.VEL_ECEF[0],TARGETMESSAGE.VEL_ECEF[1],TARGETMESSAGE.VEL_ECEF[2]" name="Target Vel ECEF" {
                    color 10 10 212
                    color 63 81 181
                    color 33 150 243
                }
            }
        }
        vsplit name="Debug Info" share=2.838696 {
            graph "STATEMACHINEOUTPUT.MISSILE_MODE,GUIDANCEMESSAGE.GUIDANCE_MODE,TARGETMESSAGE.TARGET_MODE,NAVEKFSTATE.EKF_LOOP_TIME_S" name="Modes + EKF Loop Time" share=1.0 {
                color 76 175 80
                color 33 150 243
                color 255 87 34
                color 158 158 158
            }
            hsplit name=Angles share=1.0 {
                graph "CONTROLMESSAGE.YAW_DEG,CONTROLMESSAGE.PITCH_DEG,CONTROLMESSAGE.ROLL_DEG,GUIDANCEMESSAGE.BODY_ROLL_ANGLE" name="YPR NED + Body Roll" {
                    color 76 175 80
                    color 33 150 243
                    color 255 193 7
                    color 233 30 99
                }
                graph "MFPIMUMESSAGE.GYRO.X,MFPIMUMESSAGE.GYRO.Y,MFPIMUMESSAGE.GYRO.Z" name="PIMU Gyro" {
                    color 108 60 40
                    color 132 93 40
                    color 82 31 20
                }
                graph "MFPIMUMESSAGE.ACCEL.X,MFPIMUMESSAGE.ACCEL.Y,MFPIMUMESSAGE.ACCEL.Z" name="PIMU Accel" {
                    color 155 113 48
                    color 107 39 23
                    color 36 60 102
                }
            }
            hsplit share=1.0 {
                graph "TRACKERMESSAGE.LOS_NED[0],TRACKERMESSAGE.LOS_NED[1],TRACKERMESSAGE.LOS_NED[2]" name="LOS NED" {
                    color 255 255 255
                    color 189 189 189
                    color 117 117 117
                }
                graph "GUIDANCEMESSAGE.ACC_CMD_NED[0],GUIDANCEMESSAGE.ACC_CMD_NED[1],GUIDANCEMESSAGE.ACC_CMD_NED[2]" name="Acc Cmd NED" {
                    color 0 188 212
                    color 0 150 136
                    color 63 81 181
                }
                graph "CONTROLMESSAGE.ACC_CMD_BODY[0],CONTROLMESSAGE.ACC_CMD_BODY[1]" name="Acc Cmd Body" {
                    color 108 60 40
                    color 132 93 40
                }
            }
            hsplit share=1.0 {
                graph "TRACKERMESSAGE.LOS_RATE_NED[0],TRACKERMESSAGE.LOS_RATE_NED[1],TRACKERMESSAGE.LOS_RATE_NED[2]" name="LOS Rate NED" {
                    color 255 235 59
                    color 255 193 7
                    color 255 152 0
                }
                graph "CONTROLMESSAGE.ACC_MEAS_BODY[1],CONTROLMESSAGE.ACC_MEAS_BODY[2]" name="Acc Meas Body Y/Z" {
                    color 132 93 40
                    color 82 31 20
                }
            }
            hsplit share=1.0 {
                graph "TRACKERMESSAGE.RANGE_TO_GO" name="Range To Go" {
                    color 244 67 54
                }
                graph "CONTROLMESSAGE.AILERON_CMD_DEG,CONTROLMESSAGE.ELEVATOR_CMD_DEG,CONTROLMESSAGE.RUDDER_CMD_DEG" name="Surface Commands (deg)" {
                    color 156 39 176
                    color 0 188 212
                    color 255 152 0
                }
            }
            hsplit share=1.0 {
                graph "CONTROLMESSAGE.PITCH_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.ELEVATOR_CMD_DEG,CONTROLMESSAGE.PITCH_AUTOPILOT_INTEG" name="Pitch AP (deg)" {
                    color 33 150 243
                    color 3 169 244
                    color 0 150 136
                }
                graph "CONTROLMESSAGE.YAW_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.RUDDER_CMD_DEG,CONTROLMESSAGE.YAW_AUTOPILOT_INTEG" name="Yaw AP (deg)" {
                    color 76 175 80
                    color 139 195 74
                    color 255 235 59
                }
            }
            hsplit share=1.0 {
                graph "CONTROLMESSAGE.ROLL_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.AILERON_CMD_DEG,CONTROLMESSAGE.ROLL_AUTOPILOT_INTEG" name="Roll AP (deg)" {
                    color 255 152 0
                    color 255 193 7
                    color 255 87 34
                }
                graph "CONTROLMESSAGE.FIN_DEFLECTION_DEG[0],CONTROLMESSAGE.FIN_DEFLECTION_DEG[1],CONTROLMESSAGE.FIN_DEFLECTION_DEG[2],CONTROLMESSAGE.FIN_DEFLECTION_DEG[3]" name="Fin Deflection Deg" {
                    color 100 72 168
                    color 176 98 62
                    color 201 147 54
                    color 157 75 42
                }
            }
        }
    }
    viewport name=Full_View frame=ECEF near=0.1 pos="(0,0,0,0,-1.288,-3.513,-3.500) + (NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false show_view_cube=#true show_frustum=#true
}


// Raw target report in ECEF.
object_3d frame=ECEF "(0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" {
    glb path="models/fixed_wing.glb"
    icon builtin=star {
        visibility_range min=50.0 fade_distance=50.0
        color 212 10 10
    }
}
// Target EKF estimate in ECEF.
object_3d frame="ECEF" "(0,0,0,1, EKFTARGETMESSAGE.POS_ECEF[0], EKFTARGETMESSAGE.POS_ECEF[1], EKFTARGETMESSAGE.POS_ECEF[2])" {
    glb path="models/fixed_wing.glb"
    icon builtin=star {
        visibility_range min=50.0 fade_distance=50.0
        color 10 10 212
    }
}

object_3d frame=ECEF orientation=absolute "(0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" {
    ellipsoid scale="TARGETMESSAGE.STD_POS_ECEF" show_grid=#true {
        color 0 188 212 40
        grid_color 255 255 255 120
    }
}

// NAVEKFCOV packs the lower triangle as [Pxx, Pyx, Pyy, Pzx, Pzy, Pzz].
// Elodin error_covariance expects [Pxx, Pxy, Pxz, Pyy, Pyz, Pzz], so reorder
// indices 2 and 3. Keep the covariance axes ECEF-aligned instead of rotating
// them with the vehicle body.
object_3d frame=ECEF orientation=absolute "(0,0,0,1,NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" {
    ellipsoid error_covariance="(NAVEKFCOV.PPOS_ECEF[0],NAVEKFCOV.PPOS_ECEF[1],NAVEKFCOV.PPOS_ECEF[3],NAVEKFCOV.PPOS_ECEF[2],NAVEKFCOV.PPOS_ECEF[4],NAVEKFCOV.PPOS_ECEF[5])" error_confidence_interval=70.0 show_grid=#true {
        color 0 212 188 20
        grid_color 255 255 255 120
    }
}

object_3d frame=ECEF orientation=absolute "(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" {
    glb path="models/articulated-missile-ghost-fins.glb"
    animate joint=FinGhost_0 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[0], 0)"
    animate joint=FinGhost_1 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[1], 0)"
    animate joint=FinGhost_2 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[2], 0)"
    animate joint=FinGhost_3 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[3], 0)"
    animate joint=Root.Fin_0 rotation_vector="(0, CANOPENMOTORMESSAGE0.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_1 rotation_vector="(0, CANOPENMOTORMESSAGE1.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_2 rotation_vector="(0, CANOPENMOTORMESSAGE2.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_3 rotation_vector="(0, CANOPENMOTORMESSAGE3.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    icon builtin=rocket_launch {
        color 76 175 80
        visibility_range min=50.0 fade_distance=50.0
    }
    // TODO: This should be accel.norm() but that wasn't working for some reason.
    thruster name="motor" effect="plume" intensity="MFIMUMESSAGE.ACCEL.Z/9.8 - 1.0" direction="(-1, 0, 0)" emission_rate=1300.0 cutoff=0.10 body_frame=#true position="(-0.6,0,0)"

}

object_3d frame=ECEF orientation=absolute "(0,0,0,1,NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" {
    glb path="models/compass.glb"
}
line_3d frame=ECEF "(0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" perspective=#false {
    color 255 0 0
}

line_3d frame="ECEF" "(0,0,0,1, EKFTARGETMESSAGE.POS_ECEF[0], EKFTARGETMESSAGE.POS_ECEF[1], EKFTARGETMESSAGE.POS_ECEF[2])" perspective=#false {
    color 0 0 255
}

line_3d frame=ECEF "(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" perspective=#false {
    color 0 255 0
}

