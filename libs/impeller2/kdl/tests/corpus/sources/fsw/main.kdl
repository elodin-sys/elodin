                    color 255 193 7
                    color 255 152 0
                }
                graph "CONTROLMESSAGE.ACC_MEAS_BODY[1],CONTROLMESSAGE.ACC_MEAS_BODY[2]" name="Acc Meas Body Y/Z" {
                    color 132 93 40
                    color 82 31 20
                }
            }
            hsplit share=1.0 {
                graph "TRACKERMESSAGE.RANGE_TO_GO" name="Range To Go" {
                    color 244 67 54
                }
                graph "CONTROLMESSAGE.AILERON_CMD_DEG,CONTROLMESSAGE.ELEVATOR_CMD_DEG,CONTROLMESSAGE.RUDDER_CMD_DEG" name="Surface Commands (deg)" {
                    color 156 39 176
                    color 0 188 212
                    color 255 152 0
                }
            }
            hsplit share=1.0 {
                graph "CONTROLMESSAGE.PITCH_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.ELEVATOR_CMD_DEG,CONTROLMESSAGE.PITCH_AUTOPILOT_INTEG" name="Pitch AP (deg)" {
                    color 33 150 243
                    color 3 169 244
                    color 0 150 136
                }
                graph "CONTROLMESSAGE.YAW_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.RUDDER_CMD_DEG,CONTROLMESSAGE.YAW_AUTOPILOT_INTEG" name="Yaw AP (deg)" {
                    color 76 175 80
                    color 139 195 74
                    color 255 235 59
                }
            }
            hsplit share=1.0 {
                graph "CONTROLMESSAGE.ROLL_AUTOPILOT_CMD_UNSCALED,CONTROLMESSAGE.AILERON_CMD_DEG,CONTROLMESSAGE.ROLL_AUTOPILOT_INTEG" name="Roll AP (deg)" {
                    color 255 152 0
                    color 255 193 7
                    color 255 87 34
                }
                graph "CONTROLMESSAGE.FIN_DEFLECTION_DEG[0],CONTROLMESSAGE.FIN_DEFLECTION_DEG[1],CONTROLMESSAGE.FIN_DEFLECTION_DEG[2],CONTROLMESSAGE.FIN_DEFLECTION_DEG[3]" name="Fin Deflection Deg" {
                    color 100 72 168
                    color 176 98 62
                    color 201 147 54
                    color 157 75 42
                }
            }
            graph "GPSPOSMESSAGE1.HACC,GPSPOSMESSAGE1.VACC" name="GPS HACC / VACC" share=1.0 {
                color 0 150 136
                color 255 87 34
            }
        }
        viewport name=Blank frame=ECEF near=0.1 pos="(0,0,0,1,-2429900.82,-4606958.88,3670001.99)" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_view_cube=#false share=1.86731 show_frustum=#true show_grid=#false far=15000000.0
    }
    hsplit name="Intercept" {
        vsplit {
            // Over-the-shoulder: subject fills the near field, counterpart ahead as icon.
            viewport name="Missile → Target" frame=ECEF near=0.1 far=15000000.0 pos="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-3.5,0.6,1.0)" look_at="(0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false show_view_cube=#false show_frustum=#false
            viewport name="Target → Missile" frame=ECEF near=0.1 far=15000000.0 pos="(0,0,0,0,2.371,-0.864,2.210) + (0,0,0,1,TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2])" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false show_view_cube=#false show_frustum=#false
        }
        vsplit {
            // Fixed top-down over mid-engagement corridor (SITL ~E=-2.5km, N=-0.9km).
            // Dual XY query_plot overlay is not supported yet — see docs/design-query-plot-multi-series-xy.md.
            viewport name="Trajectory Top-Down" near=0.1 far=15000000.0 fov=60.0 pos="(0,0,0,1,-2450,-870,6500)" look_at="(0,0,0,1,-2450,-870,0)" show_grid=#false show_view_cube=#false show_frustum=#false
            // Fixed side profile at ~1 km altitude; does not track missile/target.
            // Corridor runs roughly launch→SW; camera sits south looking north at intercept altitude.
            viewport name="Trajectory Side View" near=0.1 far=15000000.0 fov=50.0 pos="(0,0,0,1,-2450,-5200,1000)" look_at="(0,0,0,1,-2450,-870,1000)" show_grid=#false show_view_cube=#false show_frustum=#false
        }
    }
