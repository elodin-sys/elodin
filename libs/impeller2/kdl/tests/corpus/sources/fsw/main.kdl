theme mode=dark scheme=default

// Denser "what's happening now" layout: combined line graphs instead of
// component_monitor widgets, plus an Intercept tab for engagement views.
timeline follow_latest=#true range="last_5s"
telemetry_mode #true

skybox name=desert_night
// This is the LLA according to the vehicle at the Mojave launch site.
coordinate frame=ENU lat=35.3506640 lon=-117.80902 alt=589.2740
tabs {
    hsplit name="Dynamics and Fin Cams" {
        vsplit name="World Info" share=1.991293 {
            hsplit share=1.428405 {
                vsplit share=0.8 {
                    viewport name="Full View" frame=ECEF near=0.1 pos="(0,0,0,0,-0.221,-0.419,2.788) + (NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(-0.380511,-0.721428,0.578579)" show_grid=#false show_view_cube=#false show_frustum=#true far=15000000.0
                    viewport name="Fixed Fin Cam" frame=ECEF near=0.1 pos="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-1.2,0,0)" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" up="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).direction(0,0,1)" show_grid=#false show_view_cube=#false show_frustum=#false
                }
                vsplit share=0.8 {
                    tabs {
                    viewport name="Strake Fin 1 Cam" frame=ECEF near=0.1 pos="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-0.2,-0.07,-0.07)" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-4,0,0)" up="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).direction(0,-1,-1)" show_grid=#false show_view_cube=#false
                    viewport name="Strake Fin 3 Cam" frame=ECEF near=0.1 pos="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-0.2,0.07,0.07)" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(-4,0,0)" up="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).direction(0,-1,-1)" show_grid=#false show_view_cube=#false
                    }
                    // This ~2000m estimate for the vehicle camera far plane came from Anna.
                    viewport name="Vehicle Camera" frame=ECEF aspect=1.0 near=0.1 pos="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(1.1,0,0)" look_at="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).translate(10,0,0)" up="(NAVEKFSTATE.QUAT_ECEF2BODY[1],NAVEKFSTATE.QUAT_ECEF2BODY[2],NAVEKFSTATE.QUAT_ECEF2BODY[3],NAVEKFSTATE.QUAT_ECEF2BODY[0],NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]).direction(0,1,0)" show_grid=#false show_view_cube=#false create_frustum=#false frustums_thickness=0.01 far=2000
                }
            }
            // 2x2 vehicle kinematics (was one vertical stack — too short to read/inspect).
            hsplit name="Vehicle Kinematics" share=1.382211 {
                vsplit {
                    graph "NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2]" name="Vehicle Pos ECEF" {
                        color 76 175 80
                        color 33 150 243
                        color 255 193 7
                    }
                    graph "NAVEKFCOV.PPOS_ECEF[0].sqrt(),NAVEKFCOV.PPOS_ECEF[2].sqrt(),NAVEKFCOV.PPOS_ECEF[5].sqrt()" name="Vehicle Pos STD ECEF" {
                        color 244 67 54
                        color 255 152 0
                        color 156 39 176
                    }
                }
                vsplit {
                    graph "NAVEKFSTATE.VEL_ECEF[0],NAVEKFSTATE.VEL_ECEF[1],NAVEKFSTATE.VEL_ECEF[2]" name="Vehicle Vel ECEF" {
                        color 76 175 80
                        color 33 150 243
                        color 255 193 7
                    }
                    graph "CONTROLMESSAGE.P_DPS,CONTROLMESSAGE.Q_DPS,CONTROLMESSAGE.R_DPS" name="Body Rates (deg/s)" {
                        color 108 60 40
                        color 132 93 40
                        color 82 31 20
                    }
                }
            }
            hsplit share=0.550215 {
                graph "TARGETMESSAGE.POS_ECEF[0],TARGETMESSAGE.POS_ECEF[1],TARGETMESSAGE.POS_ECEF[2]" name="Target Pos ECEF" {
                    color 212 10 10
                    color 255 87 34
                    color 255 152 0
                }
                graph "TARGETMESSAGE.VEL_ECEF[0],TARGETMESSAGE.VEL_ECEF[1],TARGETMESSAGE.VEL_ECEF[2]" name="Target Vel ECEF" {
                    color 10 10 212
                    color 63 81 181
                    color 33 150 243
                }
            }
        }
        vsplit name="Debug Info" share=1.941397 {
            graph "STATEMACHINEOUTPUT.MISSILE_MODE,GUIDANCEMESSAGE.GUIDANCE_MODE,TARGETMESSAGE.TARGET_MODE,NAVEKFSTATE.EKF_LOOP_TIME_S" name="Modes + EKF Loop Time" share=1.0 {
                color 76 175 80
                color 33 150 243
                color 255 87 34
                color 158 158 158
            }
            hsplit name=Angles share=1.0 {
                graph "CONTROLMESSAGE.YAW_DEG,CONTROLMESSAGE.PITCH_DEG,CONTROLMESSAGE.ROLL_DEG,GUIDANCEMESSAGE.BODY_ROLL_ANGLE" name="YPR NED + Body Roll" {
                    color 76 175 80
                    color 33 150 243
                    color 255 193 7
                    color 233 30 99
                }
                graph "MFPIMUMESSAGE.GYRO.X,MFPIMUMESSAGE.GYRO.Y,MFPIMUMESSAGE.GYRO.Z" name="PIMU Gyro" {
                    color 108 60 40
                    color 132 93 40
                    color 82 31 20
                }
                graph "MFPIMUMESSAGE.ACCEL.X,MFPIMUMESSAGE.ACCEL.Y,MFPIMUMESSAGE.ACCEL.Z" name="PIMU Accel" {
                    color 155 113 48
                    color 107 39 23
                    color 36 60 102
                }
            }
            hsplit share=1.0 {
                graph "TRACKERMESSAGE.LOS_NED[0],TRACKERMESSAGE.LOS_NED[1],TRACKERMESSAGE.LOS_NED[2]" name="LOS NED" {
                    color 255 255 255
                    color 189 189 189
                    color 117 117 117
                }
                graph "GUIDANCEMESSAGE.ACC_CMD_NED[0],GUIDANCEMESSAGE.ACC_CMD_NED[1],GUIDANCEMESSAGE.ACC_CMD_NED[2]" name="Acc Cmd NED" {
                    color 0 188 212
                    color 0 150 136
                    color 63 81 181
                }
