object_3d frame=ECEF orientation=absolute "(0.0, 0.0, 0.0, 1.0, NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" {
    // k ~= 1.91 for 70% confidence interval
    // TODO: NED is not correct here. It ought to be ENU. We _should_ be able to express it like this:
    // scale="k*(x[1], x[0], x[2])" but there is an Elodin bug that prevents that.
    // NOTE: No minus for x[2] since these are standard variations.

    ellipsoid error_covariance="NAKEKFCOV.PPOS_ECEF" show_grid=#true error_confidence_interval=95 {
    //ellipsoid scale="1.91*(NAVNED.STD_POS_NED[1], NAVNED.STD_POS_NED[0], NAVNED.STD_POS_NED[2])" show_grid=#true {
        color 0 212 188 20
        grid_color 255 255 255 120
    }
}

object_3d frame=ECEF "(NAVEKFSTATE.QUAT_ECEF2BODY.X, NAVEKFSTATE.QUAT_ECEF2BODY.Y, NAVEKFSTATE.QUAT_ECEF2BODY.Z, NAVEKFSTATE.QUAT_ECEF2BODY.W, NAVEKFSTATE.POS_ECEF[0],NAVEKFSTATE.POS_ECEF[1],NAVEKFSTATE.POS_ECEF[2])" {
    glb path="models/articulated-missile-ghost-fins.glb"
    animate joint=FinGhost_0 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[0], 0)"
    animate joint=FinGhost_1 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[1], 0)"
    animate joint=FinGhost_2 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[2], 0)"
    animate joint=FinGhost_3 rotation_vector="(0, CONTROLMESSAGE.FIN_DEFLECTION_DEG[3], 0)"
    animate joint=Root.Fin_0 rotation_vector="(0, CANOPENMOTORMESSAGE0.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_1 rotation_vector="(0, CANOPENMOTORMESSAGE1.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_2 rotation_vector="(0, CANOPENMOTORMESSAGE2.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    animate joint=Root.Fin_3 rotation_vector="(0, CANOPENMOTORMESSAGE3.ACTUAL_POSITION.cast(f32)/1000.0 - 22.0, 0)"
    icon builtin=rocket_launch {
        color 76 175 80
        visibility_range min=50.0 fade_distance=50.0
    }
    // TODO: This should be accel.norm() but that wasn't working for some reason.
    thruster name="motor" effect="plume" intensity="MFIMUMESSAGE.ACCEL.Z/9.8 - 1.0" direction="(-1, 0, 0)" emission_rate=1300.0 cutoff=0.10 body_frame=#true position="(-0.6,0,0)"

}

