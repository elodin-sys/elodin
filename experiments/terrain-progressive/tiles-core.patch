+#[test]
+fn covering_parent_stays_until_all_its_children_are_prepared() {
+    let mut s = session();
+    s.nodes = (0..3).map(|_| node()).collect();
+    s.nodes[0].children = vec![1, 2];
+    for id in 0..3 {
+        s.resident.insert(id, (16, 0));
+    }
+    s.set_render_ready([0, 1]);
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![0]);
+    assert!(!frame.selection_complete);
+
+    s.set_render_ready([0, 1, 2]);
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![1, 2]);
+    assert!(frame.selection_complete);
+}
