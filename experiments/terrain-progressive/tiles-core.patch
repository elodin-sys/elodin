+#[test]
+fn progressive_coverage_prioritizes_coarse_and_frontier_tiles_before_nearby_fine_tiles() {
+    let mut s = session();
+    s.nodes = (0..4).map(|_| node()).collect();
+    s.nodes[0].children = vec![1, 2];
+    s.nodes[2].children = vec![3];
+    s.nodes[1].center.z = -100.;
+    s.nodes[1].error = 30.;
+    s.nodes[1].depth = 4;
+    s.nodes[2].error = 0.5;
+    s.nodes[2].depth = 8;
+    s.nodes[3].center.z = 1.;
+    s.nodes[3].error = 0.3;
+    s.nodes[3].depth = 9;
+    assert!(s.nodes[1].screen_error(&view()).unwrap() * 0.3 > s.maximum_screen_error);
+    assert!(s.nodes[2].screen_error(&view()).unwrap() * 0.3 < s.maximum_screen_error);
+    assert!(s.nodes[3].screen_error(&view()).unwrap() > s.maximum_screen_error);
+    let mut wanted = vec![3, 2, 1];
+    s.coverage_first = true;
+    s.prioritize_requests(&mut wanted, &[view()]);
+    assert_eq!(
+        wanted,
+        vec![1, 2, 3],
+        "a far coarse tile and a coarse-target boundary precede near refinement"
+    );
+    s.coverage_first = false;
+    s.prioritize_requests(&mut wanted, &[view()]);
+    assert_eq!(wanted, vec![3, 2, 1]);
+}
