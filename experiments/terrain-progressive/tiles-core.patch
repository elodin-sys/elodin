+    #[cfg(target_arch = "wasm32")]
+    fn audit_callback() -> Option<js_sys::Function> {
+        use wasm_bindgen::{JsCast, JsValue};
+        js_sys::Reflect::get(
+            &js_sys::global(),
+            &JsValue::from_str("__elodinTerrainAudit"),
+        )
+        .ok()?
+        .dyn_into()
+        .ok()
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    fn trace_request(&self, id: usize, views: &[View]) {
+        use wasm_bindgen::JsValue;
+        let Some(callback) = Self::audit_callback() else {
+            return;
+        };
+        let node = &self.nodes[id];
+        let error = views
+            .iter()
+            .filter_map(|view| node.screen_error(view))
+            .reduce(f64::max);
+        let hierarchy = node.terrain.is_none()
+            && node
+                .url
+                .as_ref()
+                .is_some_and(|url| url.path().ends_with(".json"));
+        let provider = node
+            .url
+            .as_ref()
+            .is_some_and(|url| self.client.requires_provider(url));
+        let row = js_sys::Array::new();
+        // Keep historical positions; retired policy fields have no upstream value.
+        for value in [
+            Some(id as f64),
+            None,
+            Some(node.depth as f64),
+            Some(node.error),
+            Some(error.unwrap_or(-1.)),
+            None,
+            None,
+            Some(u8::from(hierarchy) as f64),
+            Some(u8::from(provider) as f64),
+            Some(node.radius),
+            Some(self.maximum_screen_error),
+            None,
+        ] {
+            row.push(&value.map_or(JsValue::NULL, JsValue::from_f64));
+        }
+        row.push(&JsValue::from_str(
+            node.url
+                .as_ref()
+                .map_or("", |url| &url[..url::Position::AfterPath]),
+        ));
+        row.push(&JsValue::NULL);
+        row.push(&JsValue::NULL);
+        let _ = callback.call3(
+            &JsValue::NULL,
+            &JsValue::from_str("request"),
+            &JsValue::from_f64(js_sys::Date::now()),
+            &row,
+        );
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    fn trace_selection(&self, frame: &Frame, views: &[View]) {
+        use wasm_bindgen::JsValue;
+        let Some(callback) = Self::audit_callback() else {
+            return;
+        };
+        let ids: Vec<u32> = frame.visible.iter().map(|&id| id as u32).collect();
+        let row = js_sys::Array::new();
+        row.push(&js_sys::Uint32Array::from(ids.as_slice()));
+        let cameras = js_sys::Array::new();
+        for view in views {
+            let camera = js_sys::Array::new();
+            for value in view
+                .position
+                .into_iter()
+                .chain(view.direction)
+                .chain([view.height])
+            {
+                camera.push(&JsValue::from_f64(value));
+            }
+            cameras.push(&camera);
+        }
+        row.push(&cameras);
+        row.push(&JsValue::from_bool(frame.selection_complete));
+        let _ = callback.call3(
+            &JsValue::NULL,
+            &JsValue::from_str("selection"),
+            &JsValue::from_f64(js_sys::Date::now()),
+            &row,
+        );
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    fn trace_frame(&self, frame: &Frame) {
+        use wasm_bindgen::{JsCast, JsValue};
+        let Ok(value) = js_sys::Reflect::get(
+            &js_sys::global(),
+            &JsValue::from_str("__elodinTerrainFrames"),
+        ) else {
+            return;
+        };
+        let Ok(entries) = value.dyn_into::<js_sys::Array>() else {
+            return;
+        };
+        if entries.length() >= 6000 {
+            return;
+        }
+        let row = js_sys::Array::new();
+        for value in [
+            Some(js_sys::Date::now()),
+            Some(frame.visible.len() as f64),
+            Some(frame.pending as f64),
+            Some(self.resident.len() as f64),
+            Some(self.render_ready.as_ref().map_or(0, |tiles| tiles.len()) as f64),
+            None,
+            Some(u8::from(frame.selection_complete) as f64),
+            Some(self.stats.decoded_tiles as f64),
+            Some(self.stats.requests as f64),
+        ] {
+            row.push(&value.map_or(JsValue::NULL, JsValue::from_f64));
+        }
+        entries.push(&row);
+    }
