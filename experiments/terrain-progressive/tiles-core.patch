+#[test]
+fn coverage_finishes_uncovered_regions_before_hidden_refinement_then_resumes_detail() {
+    let mut s = session();
+    s.coverage_first = true;
+    s.partial_coverage = true;
+    s.nodes = (0..5).map(|_| node()).collect();
+    s.nodes[0].children = vec![1, 2];
+    s.nodes[1].children = vec![3, 4];
+    s.nodes[2].center.z = -100.;
+    for id in 0..2 {
+        s.resident.insert(id, (16, 0));
+    }
+    s.set_render_ready([0, 1]);
+    let mut wanted = Vec::new();
+    let mut visible = Vec::new();
+    s.select(
+        0,
+        &[view()],
+        &mut wanted,
+        &mut visible,
+        &mut HashSet::new(),
+        false,
+    );
+    assert_eq!(visible, vec![0]);
+    assert_eq!(
+        wanted,
+        vec![2],
+        "load the missing coarse region before hidden finer meshes"
+    );
+
+    s.resident.insert(2, (16, 0));
+    s.set_render_ready([0, 1, 2]);
+    wanted.clear();
+    visible.clear();
+    s.select(
+        0,
+        &[view()],
+        &mut wanted,
+        &mut visible,
+        &mut HashSet::new(),
+        false,
+    );
+    assert_eq!(visible, vec![1, 2]);
+    assert_eq!(
+        wanted,
+        vec![3, 4],
+        "resume detail once coarse replacement coverage is ready"
+    );
+}
