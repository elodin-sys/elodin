+#[test]
+fn requests_load_nearest_bounds_first_and_reorder_when_the_camera_moves() {
+    let mut s = session();
+    s.nodes = (0..3).map(|_| node()).collect();
+    s.nodes[0].center.z = -100.;
+    s.nodes[1].center.z = 0.;
+    s.nodes[2].center.z = -30.;
+    s.nodes[2].radius = 49.;
+    let mut wanted = vec![0, 1, 2];
+    s.prioritize_requests(&mut wanted, &[view()]);
+    assert_eq!(wanted, vec![2, 1, 0]);
+
+    let mut reverse = view();
+    reverse.position[2] = -120.;
+    reverse.direction[2] = 1.;
+    s.prioritize_requests(&mut wanted, &[reverse]);
+    assert_eq!(wanted, vec![0, 2, 1]);
+}
+
+#[test]
+fn equal_distance_requests_prefer_screen_center_and_keep_stable_ties() {
+    let mut s = session();
+    s.nodes = (0..3).map(|_| node()).collect();
+    s.nodes[0].center = DVec3::new(12., 0., 4.);
+    let mut wanted = vec![0, 2, 1];
+    let mut wide = view();
+    wide.horizontal_fov = 2.;
+    assert!(s.nodes[0].screen_error(&wide).is_some());
+    s.prioritize_requests(&mut wanted, &[wide]);
+    assert_eq!(wanted, vec![2, 1, 0]);
+}
+
+#[test]
+fn backdrop_allows_a_ready_child_before_its_sibling_without_overlapping_the_parent() {
+    let mut s = session();
+    s.nodes = (0..4).map(|_| node()).collect();
+    s.nodes[0].children = vec![1];
+    s.nodes[1].children = vec![2, 3];
+    for id in 0..4 {
+        s.resident.insert(id, (16, 0));
+    }
+    s.set_render_ready([0, 1, 2]);
+    assert_eq!(s.update(&[view()], 0.).unwrap().visible, vec![1]);
+
+    s.partial_coverage = true;
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![2]);
+    assert!(!frame.selection_complete);
+    assert_eq!(s.stats.requests, 0);
+
+    s.partial_coverage = false;
+    assert_eq!(s.update(&[view()], 0.).unwrap().visible, vec![1]);
+    s.partial_coverage = true;
+    s.set_render_ready(0..4);
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![2, 3]);
+    assert!(frame.selection_complete);
+}
+
+#[test]
+fn independent_regions_refine_without_waiting_for_unprepared_siblings() {
+    let mut s = session();
+    s.nodes = (0..7).map(|_| node()).collect();
+    s.nodes[0].url = None;
+    s.nodes[0].children = vec![1, 4];
+    s.nodes[1].children = vec![2, 3];
+    s.nodes[4].children = vec![5, 6];
+    for id in 1..7 {
+        s.resident.insert(id, (16, 0));
+    }
+    s.cache_bytes = 0;
+    s.set_render_ready([1, 2, 3, 4, 5]);
+
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![2, 3, 4]);
+    assert!(!frame.selection_complete);
+    assert_eq!(frame.pending, 0);
+    assert_eq!(s.stats.requests, 0);
+    assert!(s.resident.contains_key(&6));
+
+    s.set_render_ready(1..7);
+    let frame = s.update(&[view()], 0.).unwrap();
+    assert_eq!(frame.visible, vec![2, 3, 5, 6]);
+    assert!(frame.selection_complete);
+    assert_eq!(s.stats.requests, 0);
+}
