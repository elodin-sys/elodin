+    fn prioritize_requests(&self, wanted: &mut [usize], views: &[View]) {
+        let priority = |id: usize| {
+            let node = &self.nodes[id];
+            let distance = views
+                .iter()
+                .filter(|view| node.screen_error(view).is_some())
+                .map(|view| {
+                    let offset = node.center - DVec3::from_array(view.position);
+                    let center_distance = offset.length();
+                    (
+                        (center_distance - node.radius).max(0.0),
+                        1.0 - offset
+                            .normalize_or_zero()
+                            .dot(DVec3::from_array(view.direction).normalize())
+                            .clamp(-1.0, 1.0),
+                        center_distance,
+                    )
+                })
+                .min_by(|a, b| {
+                    a.0.total_cmp(&b.0)
+                        .then(a.1.total_cmp(&b.1))
+                        .then(a.2.total_cmp(&b.2))
+                })
+                .unwrap_or((f64::INFINITY, f64::INFINITY, f64::INFINITY));
+            let provider = node
+                .url
+                .as_ref()
+                .is_some_and(|url| self.client.requires_provider(url));
+            (provider, distance)
+        };
+        let mut ranked: Vec<_> = wanted.iter().map(|&id| (id, priority(id))).collect();
+        ranked.sort_by(|(_, (ap, a)), (_, (bp, b))| {
+            ap.cmp(bp)
+                .then(a.0.total_cmp(&b.0))
+                .then(a.1.total_cmp(&b.1))
+                .then(a.2.total_cmp(&b.2))
+        });
+        for (target, (id, _)) in wanted.iter_mut().zip(ranked) {
+            *target = id;
+        }
