+#[test]
+fn independent_regions_refine_without_waiting_for_unprepared_siblings() {
+    let mut s = session();
+    s.nodes = (0..7).map(|_| node()).collect();
+    s.nodes[0].url = None;
+    s.nodes[0].children = vec![1, 4];
+    s.nodes[1].children = vec![2, 3];
+    s.nodes[4].children = vec![5, 6];
+    for id in 1..7 {
+        s.resident.insert(id, (16, 0));
