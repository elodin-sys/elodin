+    s.nodes[0].children = vec![1, 2];
+    s.nodes[1].children = vec![3];
+    s.nodes[2].url =
+        Some(Url::parse("https://tile.googleapis.com/v1/3dtiles/missing.glb").unwrap());
+    s.nodes[3].url = Some(root.join("local-detail.glb").unwrap());
+    for id in 0..2 {
+        s.resident.insert(id, (16, 0));
