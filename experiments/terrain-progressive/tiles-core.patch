+#[test]
+fn browser_completion_burst_preserves_every_admitted_job() {
+    let mut s = Session::start(transport::Loader::default(), None).unwrap();
+    // The unconfigured loader fails before any HTTP request. Drain root setup first.
+    assert!(matches!(
+        s.rx.recv_timeout(std::time::Duration::from_secs(1))
+            .unwrap(),
+        Completion::Root(_)
+    ));
+    s.root_pending = false;
+    s.nodes = (0..8)
+        .map(|_| {
+            let mut n = node();
+            n.url = None;
+            n
+        })
+        .collect();
+    s.pending.extend(0..8);
+    // Browser callbacks can all finish before a frame drains the actual session queue.
+    for id in 0..8 {
+        s.tx.try_send(Completion::Content(
+            id,
+            Ok(Payload::Mesh(
+                Tile {
+                    id: id as u64,
+                    primitives: vec![],
+                },
+                vec![],
+            )),
+            0,
+        ))
+        .unwrap_or_else(|_| panic!("completion for tile {id} was lost"));
+    }
+    let frame = s.update(&[], 0.).unwrap();
+    assert_eq!(frame.loaded.len(), 8);
+    assert_eq!(s.stats.decoded_tiles, 8);
+    assert!(s.pending.is_empty());
+}
